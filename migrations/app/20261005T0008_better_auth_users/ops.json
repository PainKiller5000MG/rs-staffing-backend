  {
    "id": "user_site_scopes.no_overlap_live_only",
    "label": "no-overlap: supervisor site scopes (approved, not ended)",
    "operationClass": "widening",
    "target": {
      "id": "postgres"
    },
    "precheck": [],
    "execute": [
      {
        "description": "replace user_site_scopes_no_overlap with a live-scopes-only version",
        "sql": "ALTER TABLE app.user_site_scopes DROP CONSTRAINT user_site_scopes_no_overlap;\nALTER TABLE app.user_site_scopes\n  ADD CONSTRAINT user_site_scopes_no_overlap\n  EXCLUDE USING gist (\n    user_id WITH =,\n    site_id WITH =,\n    daterange(effective_from, COALESCE(effective_to, 'infinity'::date), '[]') WITH &&\n  ) WHERE (approved_by IS NOT NULL AND ended_at IS NULL);",
        "params": []
      }
    ],
    "postcheck": []
  },
