{
  "name": "rs-staffing-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "dev:worker": "node --watch src/worker.ts",
    "start": "node src/main.ts",
    "worker": "node src/worker.ts",
    "build": "npm run typecheck && npm run gen:openapi",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/lib test/services test/core/error-handler.test.ts test/core/guards.test.ts",
    "test:engine": "vitest run test/engine",
    "gen:openapi": "node scripts/gen-openapi.ts",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit",
    "migration:plan": "prisma migration plan --name",
    "migration:check": "prisma migration check",
    "db:migrate": "prisma db migrate --advance-ref db",
    "db:verify": "prisma db verify",
    "auth:migrate": "auth migrate --config src/auth/cli.ts --yes",
    "seed": "node seed/index.ts",
    "seed:reset": "node seed/reset.ts",
    "check": "node scripts/check.ts",
    "story": "node scripts/stories.ts",
    "new-module": "node scripts/new-module.ts",
    "lane": "node scripts/lane.ts",
    "model": "node scripts/model.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/orm-postgres": "8.0.0-rc.13",
    "awilix": "^13.0.5",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.5",
    "hono": "^4.13.13",
    "pg": "^8.22.0",
    "pg-boss": "^12.36.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.7",
    "pino-pretty": "^13.2.0",
    "prisma": "8.0.0-rc.19",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": false
  },
  "overrides": {
    "better-auth": {
      "prisma": "$prisma"
    }
  }
}
