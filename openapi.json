{
  "openapi": "3.1.0",
  "info": {
    "title": "RS Staffing API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Session cookie set by POST /api/auth/phone-number/verify"
      }
    },
    "schemas": {
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "employeeId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "siteIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "employeeId",
          "siteIds"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "ADMIN",
          "PAYROLL",
          "HR",
          "ACCOUNTS",
          "AUDITOR",
          "SUPERVISOR",
          "EMPLOYEE"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {},
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "UserList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "mobile": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "employeeId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastLoginAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "mobile",
          "email",
          "role",
          "status",
          "employeeId",
          "expiresAt",
          "lastLoginAt",
          "createdAt"
        ]
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "LOCKED",
          "DISABLED"
        ]
      },
      "UserDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/User"
          },
          {
            "type": "object",
            "properties": {
              "siteScopes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SiteScope"
                }
              }
            },
            "required": [
              "siteScopes"
            ]
          }
        ]
      },
      "SiteScope": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "siteId": {
            "type": "string",
            "format": "uuid"
          },
          "effectiveFrom": {
            "type": "string"
          },
          "effectiveTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "ENDED"
            ]
          },
          "createdBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "approvedBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "approvedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "endedBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "endedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "userId",
          "siteId",
          "effectiveFrom",
          "effectiveTo",
          "status",
          "createdBy",
          "approvedBy",
          "approvedAt",
          "endedBy",
          "endedAt"
        ]
      },
      "CreateUserBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "mobile": {
            "type": "string",
            "example": "9000000001"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 254,
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "employeeId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Required for SUPERVISOR and EMPLOYEE logins"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Auditor access end (AUDITOR only)"
          }
        },
        "required": [
          "name",
          "mobile",
          "role"
        ]
      },
      "ChangeRoleBody": {
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "role"
        ]
      },
      "AssignScopeBody": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "format": "uuid"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date",
            "description": "Defaults to today (IST)"
          }
        },
        "required": [
          "siteId"
        ]
      },
      "Site": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "stateCode": {
            "type": "string"
          },
          "minWageZone": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        },
        "required": [
          "id",
          "clientId",
          "code",
          "name",
          "stateCode",
          "minWageZone",
          "status"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "The process is up",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "The database is reachable",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
