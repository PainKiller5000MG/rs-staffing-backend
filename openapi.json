    "/users/{id}/site-scopes": {
      "post": {
        "summary": "Assign a site to a supervisor — pending until approved (M1-USR-07)",
        "tags": [
          "Users"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "schema": {
