{
  "compilerOptions": {
    // Node runs these files directly (type stripping): ESM, explicit .ts
    // extensions, and only syntax that can be erased.
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "seed/**/*", "sql/**/*", "prisma.config.ts", "vitest.config.ts"]
}
