# Copy to .env. Validated at boot (src/core/config.ts); the app refuses to start if invalid.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL >= 15. The migrating user must be allowed to CREATE ROLE (init migration).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rs_staffing"

# Better Auth. Required in production (min 32 chars); development/test use a fixed dev secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# The web app's origin (CORS + Better Auth trusted origin).
WEB_ORIGIN=http://localhost:3001

# Field encryption (Aadhaar, bank accounts): 32 bytes, base64. `openssl rand -base64 32`.
# Required in production; development/test fall back to fixed, insecure keys.
DATA_KEY=
HMAC_KEY=

# SMS: only the mock exists in P0 (writes to app.sms_outbox, prints OTPs in development).
SMS_PROVIDER=mock

# seed:reset wipes the database. For a non-local host, set this to its hostname to confirm.
# ALLOW_DB_RESET=

# Set true only when running behind our own reverse proxy (then the last X-Forwarded-For hop
# is the client). Otherwise the TCP peer is used and X-Forwarded-For is ignored.
TRUST_PROXY=false

# MSG91 (SMS_PROVIDER=msg91; all required then, validated at boot).
# Templates must use these variable names: OTP ##otp## · PAYSLIP / PAYSLIP_REVISED ##name## ##month## ##link## · FNF ##name## ##link##
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=RSSTAF
# MSG91_TPL_OTP=
# MSG91_TPL_PAYSLIP=
# MSG91_TPL_PAYSLIP_REVISED=
# MSG91_TPL_FNF=
# Delivery-report webhook: in MSG91, SMS » Webhook (New) » "Report Received" → POST /webhooks/msg91/dlr,
# add the custom header x-rs-webhook-secret with this value. Optional IP allow-list (comma-separated).
# MSG91_WEBHOOK_SECRET=
# MSG91_WEBHOOK_IPS=

# OTP limits per hour (M1-OTP-03); over them the reply is the same and no SMS is sent.
OTP_MAX_PER_PHONE_HOUR=5
OTP_MAX_PER_IP_HOUR=20
