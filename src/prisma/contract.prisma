namespace app {
  model User {
    id          Uuid                 @id @default(uuid(7))
    mobile      VarChar(15)          @unique
    email       VarChar(254)?        @unique
    name        VarChar(120)
    role        Role
    employeeId  Uuid?                @unique @map("employee_id")
    status      UserStatus           @default(ACTIVE)
    authUserId  String?              @unique @map("auth_user_id") // auth.user.id (Better Auth)
    expiresAt   Timestamptz(6)?      @map("expires_at") // auditors
    lastLoginAt Timestamptz(6)?      @map("last_login_at")
    createdAt   Timestamptz(6)       @default(now()) @map("created_at")
    createdBy   Uuid?                @map("created_by")
    updatedAt   temporal.updatedAt() @map("updated_at")
    updatedBy   Uuid?                @map("updated_by")

    employee    app.Employee?        @relation(fields: [employeeId], references: [id])
    siteScopes  UserSiteScope[]
    loginEvents LoginEvent[]

    @@index([role, status])
    @@map("users")
  }

  /// Supervisor reach. Every supervisor query filters through this.
  /// Maker-checker: a scope grants access only once approved by someone other
  /// than its creator. Revoking sets effective_to (ended_by records who).
  model UserSiteScope {
    id            Uuid            @id @default(uuid(7))
    userId        Uuid            @map("user_id")
    siteId        Uuid            @map("site_id")
    isPrimary     Boolean         @default(false) @map("is_primary") // M2-SIT-06: one approved primary per site at a time
    effectiveFrom Date            @map("effective_from")
    effectiveTo   Date?           @map("effective_to")
    createdAt     Timestamptz(6)  @default(now()) @map("created_at")
    createdBy     Uuid?           @map("created_by")
    approvedBy    Uuid?           @map("approved_by")
    approvedAt    Timestamptz(6)? @map("approved_at")
    endedBy       Uuid?           @map("ended_by")
    endedAt       Timestamptz(6)? @map("ended_at")

    user          User            @relation(fields: [userId], references: [id])
    site          Site            @relation(fields: [siteId], references: [id])

    @@index([userId])
    @@index([siteId])
    @@check(expression: "effective_to IS NULL OR effective_to >= effective_from", name: "user_site_scopes_effective_order")
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "user_site_scopes_maker_checker")
    @@map("user_site_scopes")
  }


  /// Last API activity per Better Auth session, for the idle timeout (M1-LOG-06).
  /// Written at most once a minute per session.
  model SessionActivity {
    sessionId  VarChar(64)    @id @map("session_id") // auth.session.id
    userId     Uuid           @map("user_id")
    lastSeenAt Timestamptz(6) @map("last_seen_at")

    @@index([userId])
    @@map("session_activity")
  }

  model LoginEvent {
    id     Uuid           @id @default(uuid(7))
    userId Uuid?          @map("user_id")
    mobile VarChar(15)
    result VarChar(40) // OK, OTP_FAIL, LOCKED, DISABLED...
    ip     Inet?
    at     Timestamptz(6) @default(now())

    user   User?          @relation(fields: [userId], references: [id])

    @@index([mobile, at])
    @@index([userId, at])
    @@map("login_events")
  }

  /// Replay store for POSTs that create money records (Idempotency-Key header).
  /// Written in the same transaction as the write it describes.
  model IdempotencyKey {
    id          Uuid           @id @default(uuid(7))
    userId      Uuid           @map("user_id")
    key         VarChar(100)
    method      VarChar(10)
    path        VarChar(300)
    requestHash Char(64)       @map("request_hash")
    status      SmallInt
    response    Jsonb
    createdAt   Timestamptz(6) @default(now()) @map("created_at")

    @@unique([userId, key])
    @@index([createdAt])
    @@map("idempotency_keys")
  }

  model Company {
    id        Uuid                 @id @default(uuid(7))
    legalName VarChar(200)         @map("legal_name")
    address   String
    pan       Char(10)?
    tan       Char(10)?
    logoKey   String?              @map("logo_key")
    createdAt Timestamptz(6)       @default(now()) @map("created_at")
    updatedAt temporal.updatedAt() @map("updated_at")
    updatedBy Uuid?                @map("updated_by")

    @@map("company")
  }

  /// PF / ESI registrations. Seeded with RS Staffing's own codes; more are just rows.
  model Establishment {
    id              Uuid                 @id @default(uuid(7))
    type            EstablishmentType
    code            VarChar(30)
    name            VarChar(200)
    region          VarChar(80)?
    isDefault       Boolean              @default(false) @map("is_default")
    status          RecordStatus         @default(ACTIVE)
    createdAt       Timestamptz(6)       @default(now()) @map("created_at")
    createdBy       Uuid?                @map("created_by")
    updatedAt       temporal.updatedAt() @map("updated_at")
    updatedBy       Uuid?                @map("updated_by")

    pfClients       Client[]             @relation("ClientPfEstablishment")
    esiClients      Client[]             @relation("ClientEsiEstablishment")
    complianceFiles ComplianceFile[]

    @@unique([type, code])
    @@map("establishments")
  }

  model Client {
    id                 Uuid                       @id @default(uuid(7))
    code               VarChar(30)                @unique
    name               VarChar(200)
    gstin              Char(15)?                  @unique
    pan                Char(10)?
    stateCode          VarChar(4)                 @map("state_code") // primary state
    registeredAddress  String?                    @map("registered_address")
    billingAddress     String?                    @map("billing_address")
    contractStart      Date?                      @map("contract_start")
    contractEnd        Date?                      @map("contract_end")
    workOrderNumber    VarChar(60)?               @map("work_order_number")
    pfEstablishmentId  Uuid                       @map("pf_establishment_id")
    esiEstablishmentId Uuid                       @map("esi_establishment_id")
    payPeriodStartDay  SmallInt                   @default(1) @map("pay_period_start_day") // 1 = calendar month
    status             RecordStatus               @default(ACTIVE)
    createdAt          Timestamptz(6)             @default(now()) @map("created_at")
    createdBy          Uuid?                      @map("created_by")
    updatedAt          temporal.updatedAt()       @map("updated_at")
    updatedBy          Uuid?                      @map("updated_by")

    pfEstablishment    Establishment              @relation("ClientPfEstablishment", fields: [pfEstablishmentId], references: [id])
    esiEstablishment   Establishment              @relation("ClientEsiEstablishment", fields: [esiEstablishmentId], references: [id])
    state              State                      @relation(fields: [stateCode], references: [code])
    contacts           ClientContact[]
    sites              Site[]
    attendanceImports  AttendanceImport[]
    payrollRuns        PayrollRun[]
    salaryTemplates    SalaryTemplate[]
    leaveTypes         LeaveType[]
    costAllocations    SupervisorCostAllocation[]
    workOrders         WorkOrder[]
    exportLayouts      ExportLayout[]
    attendanceLayouts  AttendanceLayout[]
    holidayReplacements HolidayReplacement[]

    @@index([stateCode])
    @@check(expression: "code ~ '^[A-Z0-9][A-Z0-9-]{2,19}$'", name: "clients_code_format")
    @@check(expression: "gstin IS NULL OR gstin ~ '^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$'", name: "clients_gstin_format")
    @@check(expression: "pan IS NULL OR pan ~ '^[A-Z]{5}[0-9]{4}[A-Z]$'", name: "clients_pan_format")
    @@check(expression: "contract_end IS NULL OR contract_start IS NULL OR contract_end >= contract_start", name: "clients_contract_order")
    @@map("clients")
  }

  model ClientContact {
    id                 Uuid                       @id @default(uuid(7))
    clientId           Uuid                       @map("client_id")
    name               VarChar(120)
    role               ContactRole
    email              VarChar(254)?
    phone              VarChar(20)?
    isAttendanceSender Boolean                    @default(false) @map("is_attendance_sender")
    status             RecordStatus               @default(ACTIVE)
    createdAt          Timestamptz(6)             @default(now()) @map("created_at")
    createdBy          Uuid?                      @map("created_by")
    updatedAt          temporal.updatedAt()       @map("updated_at")
    updatedBy          Uuid?                      @map("updated_by")

    client             Client                     @relation(fields: [clientId], references: [id])

    @@index([clientId])
    @@map("client_contacts")
  }

  model IfscCode {
    ifsc      Char(11)       @id // the Razorpay IFSC dataset, loaded monthly (M3-BNK-01)
    bankName  VarChar(80)    @map("bank_name")
    branch    VarChar(120)
    updatedAt Timestamptz(6) @default(now()) @map("updated_at")

    @@check(expression: "ifsc ~ '^[A-Z]{4}0[A-Z0-9]{6}$'", name: "ifsc_codes_format")
    @@map("ifsc_codes")
  }

  model State {
    id                   Uuid                @id @default(uuid(7))
    code                 VarChar(4)          @unique // MP, RJ, UP...
    name                 VarChar(80)
    ptApplies            Boolean             @default(false) @map("pt_applies")
    lwfApplies           Boolean             @default(false) @map("lwf_applies")
    rulesCompleteThrough Date?               @map("rules_complete_through") // missing-rules gate

    sites                Site[]
    clients              Client[]
    curEmployees         Employee[]          @relation("EmployeeCurState")
    permEmployees        Employee[]          @relation("EmployeePermState")
    ptSlabs              PtSlab[]
    lwfRates             LwfRate[]
    minWages             MinWage[]
    licences             ContractorLicence[]

    @@map("states")
  }

  model Site {
    id                 Uuid                 @id @default(uuid(7))
    clientId           Uuid                 @map("client_id")
    code               VarChar(30)          @unique
    name               VarChar(200)
    address            String               @default("") // optional in the API; "" when not given
    stateCode          VarChar(4)           @map("state_code")
    district           VarChar(80)
    pincode            Char(6)
    minWageZone        VarChar(20)?         @map("min_wage_zone")
    wageSphere         VarChar(7)?          @map("wage_sphere") // CENTRAL | STATE
    inchargeName       VarChar(120)?        @map("incharge_name")
    inchargePhone      VarChar(20)?         @map("incharge_phone")
    shiftStart         VarChar(5)?          @map("shift_start") // HH:MM
    shiftEnd           VarChar(5)?          @map("shift_end")
    lat                Numeric(9, 6)? // Phase 2 geofence
    lng                Numeric(9, 6)?
    geofenceM          Int?                 @map("geofence_m")
    status             RecordStatus         @default(ACTIVE)
    createdAt          Timestamptz(6)       @default(now()) @map("created_at")
    createdBy          Uuid?                @map("created_by")
    updatedAt          temporal.updatedAt() @map("updated_at")
    updatedBy          Uuid?                @map("updated_by")

    client             Client               @relation(fields: [clientId], references: [id])
    state              State                @relation(fields: [stateCode], references: [code])
    userScopes         UserSiteScope[]
    deployments        Deployment[]
    attendanceLayouts  AttendanceLayout[]
    dailyWorkEntries   DailyWorkEntry[]
    attendanceDays     AttendanceDay[]
    attendanceMonths   AttendanceMonth[]
    otApprovals        OtApproval[]
    runLines           RunLine[]
    cashReleases       CashRelease[]
    dailyPayoutBatches DailyPayoutBatch[]
    travelFrom         TravelLog[]          @relation("TravelFromSite")
    travelTo           TravelLog[]          @relation("TravelToSite")

    @@index([clientId])
    @@index([stateCode])
    @@check(expression: "pincode ~ '^[1-9][0-9]{5}$'", name: "sites_pincode_format")
    @@check(expression: "wage_sphere IS NULL OR wage_sphere IN ('CENTRAL','STATE')", name: "sites_wage_sphere_values")
    @@check(expression: "shift_start IS NULL OR shift_start ~ '^([01][0-9]|2[0-3]):[0-5][0-9]$'", name: "sites_shift_start_format")
    @@check(expression: "shift_end IS NULL OR shift_end ~ '^([01][0-9]|2[0-3]):[0-5][0-9]$'", name: "sites_shift_end_format")
    @@check(expression: "(lat IS NULL) = (lng IS NULL)", name: "sites_lat_lng_together")
    @@check(expression: "lat IS NULL OR (lat BETWEEN -90 AND 90 AND lng BETWEEN -180 AND 180)", name: "sites_lat_lng_range")
    @@map("sites")
  }

  /// Inherited pay settings: SITE beats CLIENT beats COMPANY.
  /// key examples: PAID_DAYS_BASIS (ACTUAL|30|26), OT_BASE (STATUTORY|GROSS),
  /// OT_DIVISOR (26|30), OT_HOURS_PER_DAY, WEEKLY_OFF_PAID.
  model PaySetting {
    id            Uuid            @id @default(uuid(7))
    scope         SettingScope
    scopeId       Uuid?           @map("scope_id") // null for COMPANY
    key           VarChar(60)
    value         VarChar(200)
    effectiveFrom Date            @map("effective_from")
    effectiveTo   Date?           @map("effective_to")
    createdAt     Timestamptz(6)  @default(now()) @map("created_at")
    createdBy     Uuid?           @map("created_by")
    approvedBy    Uuid?           @map("approved_by")
    approvedAt    Timestamptz(6)? @map("approved_at")

    @@index([key, scope, scopeId, effectiveFrom])
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "pay_settings_maker_checker")
    @@check(expression: "(scope = 'COMPANY') = (scope_id IS NULL)", name: "pay_settings_scope_id")
    @@check(expression: "effective_to IS NULL OR effective_to >= effective_from", name: "pay_settings_effective_order")
    @@map("pay_settings")
  }

  /// Human code generator (RS000001, DW00001). UPDATE ... RETURNING inside the tx.
  model CodeCounter {
    name      VarChar(30) @id // EMPLOYEE, DAILY_WORKER
    prefix    VarChar(6)
    width     SmallInt
    nextValue BigInt      @default(1) @map("next_value")

    @@map("code_counters")
  }

  model Employee {
    id                Uuid                       @id @default(uuid(7))
    code              VarChar(12)                @unique // RS000001, never reused
    legacyCode        VarChar(40)?               @map("legacy_code")
    name              VarChar(120)
    dob               Date
    gender            Gender
    mobile            VarChar(15)
    email             VarChar(254)?
    staffType         StaffType                  @map("staff_type")
    designation       VarChar(80)
    skillLevel        SkillLevel                 @default(UNSKILLED) @map("skill_level")
    paymentMode       PaymentMode                @default(BANK) @map("payment_mode")
    upiId             VarChar(80)?               @map("upi_id")
    status            EmployeeStatus             @default(DRAFT)
    joinDate          Date?                      @map("join_date")
    exitDate          Date?                      @map("exit_date")
    language          VarChar(5)                 @default("en")
    photoKey          String?                    @map("photo_key")
    fatherName        VarChar(120)?              @map("father_name") // father's or husband's name
    maritalStatus     MaritalStatus?             @map("marital_status")
    altPhone          VarChar(15)?               @map("alt_phone")
    curAddress        VarChar(300)?              @map("cur_address")
    curStateCode      VarChar(4)?                @map("cur_state_code")
    curPin            Char(6)?                   @map("cur_pin")
    permAddress       VarChar(300)?              @map("perm_address")
    permStateCode     VarChar(4)?                @map("perm_state_code")
    permPin           Char(6)?                   @map("perm_pin")
    aadhaarLast4      Char(4)?                   @map("aadhaar_last4") // the full number lives only in vault.aadhaar_records
    createdAt         Timestamptz(6)             @default(now()) @map("created_at")
    createdBy         Uuid?                      @map("created_by")
    updatedAt         temporal.updatedAt()       @map("updated_at")
    updatedBy         Uuid?                      @map("updated_by")

    curState          State?                     @relation("EmployeeCurState", fields: [curStateCode], references: [code])
    permState         State?                     @relation("EmployeePermState", fields: [permStateCode], references: [code])
    user              User?
    aadhaar           vault.AadhaarRecord?
    statutory         EmployeeStatutory?
    bankAccounts      BankAccount[]
    deployments       Deployment[]
    documents         EmployeeDocument[]
    nominees          Nominee[]
    events            EmployeeEvent[]
    convertedFrom     DailyWorker?
    salaryStructures  EmployeeSalaryStructure[]
    attendanceDays    AttendanceDay[]
    attendanceMonths  AttendanceMonth[]
    leaveLedger       LeaveLedger[]
    leaveApplications LeaveApplication[]
    otApprovals       OtApproval[]
    runLines          RunLine[]
    advances          Advance[]
    fnfCases          FnfCase[]
    cashReleases      CashRelease[]              @relation("CashReleaseSupervisor")
    travelLogs        TravelLog[]
    costAllocations   SupervisorCostAllocation[]

    @@index([legacyCode])
    @@index([mobile])
    @@index([status, staffType])
    @@check(expression: "cur_pin IS NULL OR cur_pin ~ '^[1-9][0-9]{5}$'", name: "employees_cur_pin_format")
    @@check(expression: "perm_pin IS NULL OR perm_pin ~ '^[1-9][0-9]{5}$'", name: "employees_perm_pin_format")
    @@check(expression: "join_date IS NULL OR join_date >= (dob + interval '18 years')", name: "employees_adult_at_joining")
    @@map("employees")
  }

  model EmployeeStatutory {
    employeeId   Uuid                 @id @map("employee_id")
    uan          Char(12)?            @unique
    pfMemberFrom Date?                @map("pf_member_from")
    pfExempt     Boolean              @default(false) @map("pf_exempt")
    pfFullWages  Boolean              @default(false) @map("pf_full_wages") // EPF Scheme para 26(6) opt-in
    esiIpNo      VarChar(17)?         @unique @map("esi_ip_no")
    esiFrom      Date?                @map("esi_from")
    ptExempt     Boolean              @default(false) @map("pt_exempt")
    pan          Char(10)?            @unique
    updatedAt    temporal.updatedAt() @map("updated_at")
    updatedBy    Uuid?                @map("updated_by")

    employee     Employee             @relation(fields: [employeeId], references: [id])

    @@check(expression: "pan IS NULL OR pan ~ '^[A-Z]{3}[PCHFATBLJG][A-Z][0-9]{4}[A-Z]$'", name: "employee_statutory_pan_format")
    @@map("employee_statutory")
  }

  model BankAccount {
    id            Uuid            @id @default(uuid(7))
    employeeId    Uuid            @map("employee_id")
    accountEnc    Bytes           @map("account_enc")
    accountLast4  Char(4)         @map("account_last4")
    ifsc          Char(11)
    holderName    VarChar(120)    @map("holder_name")
    accountHmac   VarChar(64)?    @map("account_hmac") // null only on pre-verification rows; lookup for the shared-account check (M3-BNK-06)
    accountType   BankAccountType @default(SAVINGS) @map("account_type")
    bankName      VarChar(80)?    @map("bank_name") // from the IFSC table
    branch        VarChar(120)?
    proofKey      String?         @map("proof_key") // cancelled cheque / passbook image
    verifyStatus  BankVerifyStatus @default(PENDING) @map("verify_status")
    verifiedAt    Timestamptz(6)? @map("verified_at")
    verifyRef     VarChar(80)?    @map("verify_ref")
    bankReturnedName VarChar(120)? @map("bank_returned_name")
    nameMatchScore Int?           @map("name_match_score")
    mismatchApprovedBy Uuid?      @map("mismatch_approved_by")
    mismatchReason VarChar(300)?  @map("mismatch_reason")
    sharedOverrideBy Uuid?        @map("shared_override_by")
    sharedOverrideReason VarChar(300)? @map("shared_override_reason")
    isPrimary     Boolean         @default(true) @map("is_primary")
    effectiveFrom Date            @map("effective_from")
    effectiveTo   Date?           @map("effective_to")
    createdAt     Timestamptz(6)  @default(now()) @map("created_at")
    createdBy     Uuid?           @map("created_by")
    approvedBy    Uuid?           @map("approved_by")
    approvedAt    Timestamptz(6)? @map("approved_at")

    employee      Employee        @relation(fields: [employeeId], references: [id])

    @@index([employeeId])
    @@index([accountHmac])
    @@check(expression: "name_match_score IS NULL OR (name_match_score BETWEEN 0 AND 100)", name: "bank_accounts_score_range")
    @@check(expression: "approved_by IS NULL OR verify_status = 'VERIFIED' OR (verify_status = 'NAME_MISMATCH' AND mismatch_approved_by IS NOT NULL AND mismatch_reason IS NOT NULL)", name: "bank_accounts_approved_needs_verified")
    @@check(expression: "mismatch_approved_by IS NULL OR created_by IS NULL OR mismatch_approved_by <> created_by", name: "bank_accounts_mismatch_maker_checker")
    @@check(expression: "shared_override_by IS NULL OR shared_override_reason IS NOT NULL", name: "bank_accounts_shared_override_reason")
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "bank_accounts_maker_checker")
    @@check(expression: "effective_to IS NULL OR effective_to >= effective_from", name: "bank_accounts_effective_order")
    @@map("bank_accounts")
  }

  /// No overlapping rows per employee (exclusion constraint in sql/001_extras.sql).
  model Deployment {
    id            Uuid           @id @default(uuid(7))
    employeeId    Uuid           @map("employee_id")
    siteId        Uuid           @map("site_id")
    designation   VarChar(80)
    skillLevel    SkillLevel     @map("skill_level")
    templateId    Uuid?          @map("template_id") // salary structure (template) the pay is built from
    monthlyCtcPaise BigInt       @map("monthly_ctc_paise")
    kind          VarChar(10)    @default("DEPLOY") // DEPLOY | REDEPLOY | REVISION
    reason        VarChar(200)?
    effectiveFrom Date           @map("effective_from")
    effectiveTo   Date?          @map("effective_to")
    createdAt     Timestamptz(6) @default(now()) @map("created_at")
    createdBy     Uuid?          @map("created_by")

    employee      Employee       @relation(fields: [employeeId], references: [id])
    site          Site           @relation(fields: [siteId], references: [id])
    template      SalaryTemplate? @relation(fields: [templateId], references: [id])

    @@index([employeeId, effectiveFrom])
    @@index([siteId, effectiveFrom])
    @@check(expression: "effective_to IS NULL OR effective_to >= effective_from", name: "deployments_effective_order")
    @@check(expression: "monthly_ctc_paise > 0", name: "deployments_ctc_positive")
    @@check(expression: "kind IN ('DEPLOY','REDEPLOY','REVISION')", name: "deployments_kind_values")
    @@map("deployments")
  }

  model EmployeeDocument {
    id         Uuid           @id @default(uuid(7))
    employeeId Uuid           @map("employee_id")
    type       VarChar(40)
    fileKey    String         @map("file_key")
    expiresOn  Date?          @map("expires_on")
    createdAt  Timestamptz(6) @default(now()) @map("created_at")
    createdBy  Uuid?          @map("created_by")

    employee   Employee       @relation(fields: [employeeId], references: [id])

    @@index([employeeId])
    @@map("employee_documents")
  }

  model Nominee {
    id         Uuid           @id @default(uuid(7))
    employeeId Uuid           @map("employee_id")
    name       VarChar(120)
    relation   VarChar(40)
    sharePct   Numeric(5, 2)  @map("share_pct")
    scheme     NomineeScheme
    createdAt  Timestamptz(6) @default(now()) @map("created_at")
    createdBy  Uuid?          @map("created_by")

    employee   Employee       @relation(fields: [employeeId], references: [id])
    fnfCases   FnfCase[]

    @@index([employeeId])
    @@check(expression: "share_pct > 0 AND share_pct <= 100", name: "nominees_share_range")
    @@map("nominees")
  }

  model EmployeeEvent {
    id         Uuid              @id @default(uuid(7))
    employeeId Uuid              @map("employee_id")
    type       EmployeeEventType
    date       Date
    reason     String?
    createdAt  Timestamptz(6)    @default(now()) @map("created_at")
    createdBy  Uuid?             @map("created_by")

    employee   Employee          @relation(fields: [employeeId], references: [id])
    fnfCases   FnfCase[]

    @@index([employeeId, date])
    @@map("employee_events")
  }

  /// DPDP consent for employees and daily-wage workers (polymorphic subject).
  model Consent {
    id          Uuid            @id @default(uuid(7))
    subjectType SubjectType     @map("subject_type")
    subjectId   Uuid            @map("subject_id")
    purpose     VarChar(80)
    version     VarChar(20)
    givenAt     Timestamptz(6)  @map("given_at")
    withdrawnAt Timestamptz(6)? @map("withdrawn_at")
    evidenceKey String?         @map("evidence_key")
    createdBy   Uuid?           @map("created_by")

    @@index([subjectType, subjectId])
    @@map("consents")
  }

  model DailyWorker {
    id                  Uuid                 @id @default(uuid(7))
    code                VarChar(12)          @unique // DW00001
    name                VarChar(120)
    mobile              VarChar(15)?
    photoKey            String?              @map("photo_key")
    paymentMode         PaymentMode          @default(CASH) @map("payment_mode")
    upiId               VarChar(80)?         @map("upi_id")
    blocklisted         Boolean              @default(false)
    blocklistReason     String?              @map("blocklist_reason")
    convertedEmployeeId Uuid?                @unique @map("converted_employee_id")
    createdAt           Timestamptz(6)       @default(now()) @map("created_at")
    createdBy           Uuid?                @map("created_by")
    updatedAt           temporal.updatedAt() @map("updated_at")
    updatedBy           Uuid?                @map("updated_by")

    aadhaar             vault.AadhaarRecord?
    convertedEmployee   Employee?            @relation(fields: [convertedEmployeeId], references: [id])
    workEntries         DailyWorkEntry[]
    cashPayouts         CashPayout[]

    @@index([mobile])
    @@map("daily_workers")
  }

  model DailyWorkEntry {
    id             Uuid              @id @default(uuid(7))
    dailyWorkerId  Uuid              @map("daily_worker_id")
    siteId         Uuid              @map("site_id")
    workDate       Date              @map("work_date")
    dailyWagePaise BigInt            @map("daily_wage_paise")
    otHours        Numeric(5, 2)     @default(0) @map("ot_hours")
    status         WorkEntryStatus   @default(PENDING)
    payoutBatchId  Uuid?             @map("payout_batch_id")
    createdAt      Timestamptz(6)    @default(now()) @map("created_at")
    createdBy      Uuid?             @map("created_by")
    approvedBy     Uuid?             @map("approved_by")
    approvedAt     Timestamptz(6)?   @map("approved_at")

    dailyWorker    DailyWorker       @relation(fields: [dailyWorkerId], references: [id])
    site           Site              @relation(fields: [siteId], references: [id])
    payoutBatch    DailyPayoutBatch? @relation(fields: [payoutBatchId], references: [id])

    @@unique([dailyWorkerId, siteId, workDate], map: "daily_work_entries_worker_site_date_key")
    @@index([siteId, workDate, status])
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "daily_work_entries_maker_checker")
    @@map("daily_work_entries")
  }

  /// Statutory constants by code and date. The Sep 2026 EPF split is two
  /// PF_CEILING rows (15,000 to 2026-09-16; 25,000 from 2026-09-17) + SPLIT_METHOD.
  model StatutoryRule {
    id            Uuid            @id @default(uuid(7))
    code          VarChar(40)
    value         Jsonb
    effectiveFrom Date            @map("effective_from")
    effectiveTo   Date?           @map("effective_to")
    sourceUrl     String?         @map("source_url")
    note          String?
    createdAt     Timestamptz(6)  @default(now()) @map("created_at")
    createdBy     Uuid?           @map("created_by")
    approvedBy    Uuid?           @map("approved_by")
    approvedAt    Timestamptz(6)? @map("approved_at")

    @@index([code, effectiveFrom])
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "statutory_rules_maker_checker")
    @@check(expression: "effective_to IS NULL OR effective_to >= effective_from", name: "statutory_rules_effective_order")
    @@map("statutory_rules")
  }

  model PtSlab {
    id            Uuid           @id @default(uuid(7))
    stateCode     VarChar(4)     @map("state_code")
    gender        Gender?
    fromPaise     BigInt         @map("from_paise")
    toPaise       BigInt?        @map("to_paise")
    amountPaise   BigInt         @map("amount_paise")
    monthOverride SmallInt?      @map("month_override") // e.g. 2 = February amount
    effectiveFrom Date           @map("effective_from")
    effectiveTo   Date?          @map("effective_to")
    note          String? // "VERIFY…" blocks a production lock (A7)
    createdAt     Timestamptz(6) @default(now()) @map("created_at")
    createdBy     Uuid?          @map("created_by")

    state         State          @relation(fields: [stateCode], references: [code])

    @@index([stateCode, effectiveFrom])
    @@check(expression: "effective_to IS NULL OR effective_to >= effective_from", name: "pt_slabs_effective_order")
    @@map("pt_slabs")
  }

  model LwfRate {
    id            Uuid           @id @default(uuid(7))
    stateCode     VarChar(4)     @map("state_code")
    eePaise       BigInt         @map("ee_paise")
    erPaise       BigInt         @map("er_paise")
    frequency     LwfFrequency
    deductMonths  SmallInt[]     @map("deduct_months")
    effectiveFrom Date           @map("effective_from")
    effectiveTo   Date?          @map("effective_to")
    note          String? // "VERIFY…" blocks a production lock (A7)
    createdAt     Timestamptz(6) @default(now()) @map("created_at")
    createdBy     Uuid?          @map("created_by")

    state         State          @relation(fields: [stateCode], references: [code])

    @@index([stateCode, effectiveFrom])
    @@check(expression: "effective_to IS NULL OR effective_to >= effective_from", name: "lwf_rates_effective_order")
    @@map("lwf_rates")
  }

  model MinWage {
    id            Uuid           @id @default(uuid(7))
    stateCode     VarChar(4)     @map("state_code")
    zone          VarChar(20)
    skillLevel    SkillLevel     @map("skill_level")
    basicPaise    BigInt         @map("basic_paise")
    vdaPaise      BigInt         @default(0) @map("vda_paise")
    per           WagePer
    effectiveFrom Date           @map("effective_from")
    effectiveTo   Date?          @map("effective_to")
    sourceUrl     String?        @map("source_url")
    note          String? // "VERIFY…" blocks a production lock (A7)
    createdAt     Timestamptz(6) @default(now()) @map("created_at")
    createdBy     Uuid?          @map("created_by")

    state         State          @relation(fields: [stateCode], references: [code])

    @@index([stateCode, zone, skillLevel, effectiveFrom], name: "min_wages_lookup")
    @@check(expression: "effective_to IS NULL OR effective_to >= effective_from", name: "min_wages_effective_order")
    @@map("min_wages")
  }

  /// scopeKey: state code for STATE, client id for CLIENT, site id for SITE, null for NATIONAL.
  /// Never deleted: removedAt hides a row (the live-row unique index is in the migration).
  model Holiday {
    id           Uuid                 @id @default(uuid(7))
    level        HolidayLevel
    scopeKey     VarChar(40)?         @map("scope_key")
    date         Date
    year         SmallInt
    name         VarChar(120)
    paid         Boolean              @default(true)
    optional     Boolean              @default(false)
    half         Boolean              @default(false) // P1: half-day holiday = 0.5 paid holiday + 0.5 working day
    createdAt    Timestamptz(6)       @default(now()) @map("created_at")
    createdBy    Uuid?                @map("created_by")
    removedAt    Timestamptz(6)?      @map("removed_at")
    removedBy    Uuid?                @map("removed_by")

    replacements HolidayReplacement[]

    @@index([date])
    @@index([level, scopeKey, year])
    @@check(expression: "year = EXTRACT(YEAR FROM date)", name: "holidays_year_matches_date")
    @@check(expression: "(level = 'NATIONAL') = (scope_key IS NULL)", name: "holidays_scope_key_by_level")
    @@check(expression: "level <> 'NATIONAL' OR (paid AND NOT optional AND NOT half)", name: "holidays_national_paid_fixed")
    @@check(expression: "(removed_at IS NULL) = (removed_by IS NULL)", name: "holidays_removed_together")
    @@map("holidays")
  }

  /// A client swaps a STATE holiday for another day (M14-HOL-02). National holidays can't be replaced.
  model HolidayReplacement {
    id              Uuid            @id @default(uuid(7))
    clientId        Uuid            @map("client_id")
    holidayId       Uuid            @map("holiday_id")
    replacementDate Date            @map("replacement_date")
    createdAt       Timestamptz(6)  @default(now()) @map("created_at")
    createdBy       Uuid?           @map("created_by")
    removedAt       Timestamptz(6)? @map("removed_at")
    removedBy       Uuid?           @map("removed_by")

    client          Client          @relation(fields: [clientId], references: [id])
    holiday         Holiday         @relation(fields: [holidayId], references: [id])

    @@index([clientId])
    @@index([holidayId])
    @@check(expression: "(removed_at IS NULL) = (removed_by IS NULL)", name: "holiday_replacements_removed_together")
    @@map("holiday_replacements")
  }

  /// Flags decide every statutory base (50% wage rule, ESI gross, PF wages).
  model SalaryComponent {
    id                Uuid                 @id @default(uuid(7))
    code              VarChar(30)          @unique // BASIC, DA, HRA, OT, TRAVEL_KM, PF_EE...
    name              VarChar(80)
    kind              ComponentKind
    inWages           Boolean              @default(false) @map("in_wages")
    inEsiGross        Boolean              @default(false) @map("in_esi_gross")
    inPfWages         Boolean              @default(false) @map("in_pf_wages")
    taxable           Boolean              @default(true)
    displayOrder      Int                  @default(100) @map("display_order")
    status            RecordStatus         @default(ACTIVE)

    templateLines     SalaryTemplateLine[] @relation("TemplateLineComponent")
    templateBaseLines SalaryTemplateLine[] @relation("TemplateLineBase")
    employeeLines     EmployeeSalaryLine[]
    runLineItems      RunLineItem[]

    @@map("salary_components")
  }

  model SalaryTemplate {
    id         Uuid                      @id @default(uuid(7))
    code       VarChar(40)               @unique // MIN_WAGE, CONSOLIDATED, HQ_STAFF
    name       VarChar(120)
    clientId   Uuid?                     @map("client_id")
    status     RecordStatus              @default(ACTIVE)
    createdAt  Timestamptz(6)            @default(now()) @map("created_at")
    createdBy  Uuid?                     @map("created_by")

    client     Client?                   @relation(fields: [clientId], references: [id])
    lines      SalaryTemplateLine[]
    structures EmployeeSalaryStructure[]
    deployments Deployment[]

    @@map("salary_templates")
  }

  model SalaryTemplateLine {
    id              Uuid             @id @default(uuid(7))
    templateId      Uuid             @map("template_id")
    componentId     Uuid             @map("component_id")
    calc            CalcType
    value           Numeric(14, 4)? // paise for FIXED, percent for PCT_OF
    baseComponentId Uuid?            @map("base_component_id")
    order           SmallInt

    template        SalaryTemplate   @relation(fields: [templateId], references: [id])
    component       SalaryComponent  @relation("TemplateLineComponent", fields: [componentId], references: [id])
    baseComponent   SalaryComponent? @relation("TemplateLineBase", fields: [baseComponentId], references: [id])

    @@unique([templateId, componentId])
    @@map("salary_template_lines")
  }

  model EmployeeSalaryStructure {
    id                Uuid                 @id @default(uuid(7))
    employeeId        Uuid                 @map("employee_id")
    templateId        Uuid?                @map("template_id")
    monthlyGrossPaise BigInt               @map("monthly_gross_paise")
    effectiveFrom     Date                 @map("effective_from")
    effectiveTo       Date?                @map("effective_to")
    createdAt         Timestamptz(6)       @default(now()) @map("created_at")
    createdBy         Uuid?                @map("created_by")
    approvedBy        Uuid?                @map("approved_by")
    approvedAt        Timestamptz(6)?      @map("approved_at")

    employee          Employee             @relation(fields: [employeeId], references: [id])
    template          SalaryTemplate?      @relation(fields: [templateId], references: [id])
    lines             EmployeeSalaryLine[]

    @@index([employeeId, effectiveFrom], name: "employee_salary_structures_employee_effective_idx")
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "employee_salary_structures_maker_checker")
    @@check(expression: "effective_to IS NULL OR effective_to >= effective_from", name: "employee_salary_structures_effective_order")
    @@map("employee_salary_structures")
  }

  model EmployeeSalaryLine {
    id          Uuid                    @id @default(uuid(7))
    structureId Uuid                    @map("structure_id")
    componentId Uuid                    @map("component_id")
    amountPaise BigInt                  @map("amount_paise")

    structure   EmployeeSalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
    component   SalaryComponent         @relation(fields: [componentId], references: [id])

    @@unique([structureId, componentId])
    @@map("employee_salary_lines")
  }

  model AttendanceImport {
    id         Uuid                   @id @default(uuid(7))
    clientId   Uuid                   @map("client_id")
    month      Date // first day of wage month
    fileKey    String                 @map("file_key")
    fileSha256 Char(64)               @map("file_sha256")
    status     AttendanceImportStatus @default(STAGING)
    counts     Jsonb?
    createdAt  Timestamptz(6)         @default(now()) @map("created_at")
    createdBy  Uuid?                  @map("created_by")
    approvedBy Uuid?                  @map("approved_by")
    approvedAt Timestamptz(6)?        @map("approved_at")

    layoutId   Uuid?                  @map("layout_id") // the layout version this file was read with (M2-SET-05 AC4)

    client     Client                 @relation(fields: [clientId], references: [id])
    layout     AttendanceLayout?      @relation(fields: [layoutId], references: [id])
    rows       AttendanceImportRow[]
    days       AttendanceDay[]

    @@index([clientId, month, status])
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "attendance_imports_maker_checker")
    @@map("attendance_imports")
  }

  /// M2-SET-05: a client's attendance sheet layout. Every row is one immutable version (a trigger refuses
  /// UPDATE/DELETE): editing inserts version + 1 under the same layoutKey, and imports point at the version they used.
  model AttendanceLayout {
    id                Uuid               @id @default(uuid(7))
    layoutKey         Uuid               @map("layout_key") // same for every version of one layout
    version           Int
    clientId          Uuid               @map("client_id")
    siteId            Uuid?              @map("site_id") // set when this sheet is one site's own
    name              VarChar(120)
    definition        Jsonb // sheet, layout type, header row, identity/day/OT columns, status code map
    headerFingerprint VarChar(128)       @map("header_fingerprint")
    confirmedBy       Uuid?              @map("confirmed_by")
    confirmedAt       Timestamptz(6)?    @map("confirmed_at")
    createdAt         Timestamptz(6)     @default(now()) @map("created_at")
    createdBy         Uuid?              @map("created_by")

    client            Client             @relation(fields: [clientId], references: [id])
    site              Site?              @relation(fields: [siteId], references: [id])
    imports           AttendanceImport[]

    @@unique([layoutKey, version])
    @@index([clientId, layoutKey])
    @@check(expression: "version >= 1", name: "attendance_layouts_version_positive")
    @@check(expression: "(confirmed_by IS NULL) = (confirmed_at IS NULL)", name: "attendance_layouts_confirmed")
    @@map("attendance_layouts")
  }

  /// Staging only — nothing reaches payroll until the import is ACCEPTED.
  model AttendanceImportRow {
    id           Uuid             @id @default(uuid(7))
    importId     Uuid             @map("import_id")
    rowNo        Int              @map("row_no")
    employeeCode VarChar(40)      @map("employee_code")
    siteCode     VarChar(30)      @map("site_code")
    codes        VarChar(4)[] // D1..D31 raw codes
    otHours      Numeric(6, 2)?   @map("ot_hours")
    errors       Jsonb?
    employeeId   Uuid?            @map("employee_id")

    import       AttendanceImport @relation(fields: [importId], references: [id], onDelete: Cascade)

    @@unique([importId, rowNo])
    @@map("attendance_import_rows")
  }

  model AttendanceDay {
    id          Uuid                   @id @default(uuid(7))
    employeeId  Uuid                   @map("employee_id")
    siteId      Uuid                   @map("site_id")
    date        Date
    code        DayCode
    otHours     Numeric(5, 2)          @default(0) @map("ot_hours")
    importId    Uuid?                  @map("import_id")
    source      AttendanceSource
    createdAt   Timestamptz(6)         @default(now()) @map("created_at")
    updatedAt   temporal.updatedAt()   @map("updated_at")
    updatedBy   Uuid?                  @map("updated_by")

    employee    Employee               @relation(fields: [employeeId], references: [id])
    site        Site                   @relation(fields: [siteId], references: [id])
    import      AttendanceImport?      @relation(fields: [importId], references: [id])
    corrections AttendanceCorrection[]

    @@unique([employeeId, date])
    @@index([siteId, date])
    @@map("attendance_days")
  }

  /// One summary row per employee per wage month; frozen once a run locks.
  model AttendanceMonth {
    id            Uuid           @id @default(uuid(7))
    employeeId    Uuid           @map("employee_id")
    month         Date
    siteId        Uuid?          @map("site_id") // main site; null if moved mid-month
    present       Numeric(5, 1)
    halfDays      SmallInt       @map("half_days")
    weeklyOffs    SmallInt       @map("weekly_offs")
    woWorked      SmallInt       @map("wo_worked")
    holidays      SmallInt
    holidayWorked SmallInt       @map("holiday_worked")
    leaveDays     Jsonb          @map("leave_days") // {"EL":1,"CL":0.5}
    lopDays       Numeric(5, 1)  @map("lop_days")
    otHours       Numeric(6, 2)  @map("ot_hours")
    paidDays      Numeric(5, 1)  @map("paid_days")
    frozen        Boolean        @default(false)
    computedAt    Timestamptz(6) @default(now()) @map("computed_at")

    employee      Employee       @relation(fields: [employeeId], references: [id])
    site          Site?          @relation(fields: [siteId], references: [id])

    @@unique([employeeId, month])
    @@map("attendance_months")
  }

  /// Supervisor fixes wait here until HQ approves.
  model AttendanceCorrection {
    id              Uuid            @id @default(uuid(7))
    attendanceDayId Uuid            @map("attendance_day_id")
    oldCode         DayCode         @map("old_code")
    newCode         DayCode         @map("new_code")
    oldOtHours      Numeric(5, 2)?  @map("old_ot_hours")
    newOtHours      Numeric(5, 2)?  @map("new_ot_hours")
    reason          String
    status          ApprovalStatus  @default(PENDING)
    createdAt       Timestamptz(6)  @default(now()) @map("created_at")
    createdBy       Uuid?           @map("created_by")
    approvedBy      Uuid?           @map("approved_by")
    approvedAt      Timestamptz(6)? @map("approved_at")

    attendanceDay   AttendanceDay   @relation(fields: [attendanceDayId], references: [id])

    @@index([status, createdAt])
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "attendance_corrections_maker_checker")
    @@map("attendance_corrections")
  }

  model LeaveType {
    id              Uuid               @id @default(uuid(7))
    code            VarChar(10) // EL, CL, SL...
    name            VarChar(80)
    accrualRule     Jsonb              @map("accrual_rule") // {"per":20,"days":1,"eligibleAfterDays":180}
    carryForwardMax Numeric(5, 1)?     @map("carry_forward_max")
    encashable      Boolean            @default(false)
    clientId        Uuid?              @map("client_id")
    status          RecordStatus       @default(ACTIVE)

    client          Client?            @relation(fields: [clientId], references: [id])
    ledger          LeaveLedger[]
    applications    LeaveApplication[]

    @@unique([code, clientId])
    @@map("leave_types")
  }

  /// Balance = SUM(delta). Never update a row; add a reversing one.
  model LeaveLedger {
    id            Uuid              @id @default(uuid(7))
    employeeId    Uuid              @map("employee_id")
    leaveTypeId   Uuid              @map("leave_type_id")
    date          Date
    delta         Numeric(5, 1)
    reason        LeaveLedgerReason
    applicationId Uuid?             @map("application_id")
    runId         Uuid?             @map("run_id") // encashment run
    note          String?
    createdAt     Timestamptz(6)    @default(now()) @map("created_at")
    createdBy     Uuid?             @map("created_by")

    employee      Employee          @relation(fields: [employeeId], references: [id])
    leaveType     LeaveType         @relation(fields: [leaveTypeId], references: [id])
    application   LeaveApplication? @relation(fields: [applicationId], references: [id])

    @@index([employeeId, leaveTypeId, date])
    @@map("leave_ledger")
  }

  model LeaveApplication {
    id          Uuid            @id @default(uuid(7))
    employeeId  Uuid            @map("employee_id")
    leaveTypeId Uuid            @map("leave_type_id")
    fromDate    Date            @map("from_date")
    toDate      Date            @map("to_date")
    days        Numeric(5, 1)
    reason      String?
    status      ApprovalStatus  @default(PENDING)
    appliedBy   Uuid            @map("applied_by") // self or supervisor user id
    createdAt   Timestamptz(6)  @default(now()) @map("created_at")
    approvedBy  Uuid?           @map("approved_by")
    approvedAt  Timestamptz(6)? @map("approved_at")

    employee    Employee        @relation(fields: [employeeId], references: [id])
    leaveType   LeaveType       @relation(fields: [leaveTypeId], references: [id])
    ledger      LeaveLedger[]

    @@index([employeeId, fromDate])
    @@index([status, createdAt])
    @@check(expression: "approved_by IS NULL OR approved_by <> applied_by", name: "leave_apps_maker_checker")
    @@check(expression: "to_date >= from_date AND days > 0", name: "leave_apps_date_order")
    @@map("leave_applications")
  }

  /// P1 — OT pre-approval.
  model OtApproval {
    id         Uuid           @id @default(uuid(7))
    siteId     Uuid           @map("site_id")
    employeeId Uuid?          @map("employee_id")
    date       Date
    maxHours   Numeric(5, 2)  @map("max_hours")
    createdAt  Timestamptz(6) @default(now()) @map("created_at")
    approvedBy Uuid?          @map("approved_by")

    site       Site           @relation(fields: [siteId], references: [id])
    employee   app.Employee?  @relation(fields: [employeeId], references: [id])

    @@index([siteId, date])
    @@map("ot_approvals")
  }

  model PayrollRun {
    id              Uuid                       @id @default(uuid(7))
    clientId        Uuid?                      @map("client_id") // null for INTERNAL runs
    type            RunType
    periodFrom      Date                       @map("period_from")
    periodTo        Date                       @map("period_to")
    status          RunStatus                  @default(DRAFT)
    version         Int                        @default(1)
    parentRunId     Uuid?                      @map("parent_run_id")
    totals          Jsonb?
    computedBy      Uuid?                      @map("computed_by")
    computedAt      Timestamptz(6)?            @map("computed_at")
    lockedBy        Uuid?                      @map("locked_by") // must differ from computedBy (@@check below)
    lockedAt        Timestamptz(6)?            @map("locked_at")
    publishedAt     Timestamptz(6)?            @map("published_at")
    createdAt       Timestamptz(6)             @default(now()) @map("created_at")
    createdBy       Uuid?                      @map("created_by")

    client          Client?                    @relation(fields: [clientId], references: [id])
    parentRun       PayrollRun?                @relation("RunVersions", fields: [parentRunId], references: [id])
    childRuns       PayrollRun[]               @relation("RunVersions")
    lines           RunLine[]
    fnfCases        FnfCase[]
    paymentBatches  PaymentBatch[]
    cashReleases    CashRelease[]
    costAllocations SupervisorCostAllocation[]
    deliveryBatches DeliveryBatch[]

    @@unique([clientId, type, periodFrom, version])
    @@index([status])
    @@check(expression: "locked_by IS NULL OR computed_by IS NULL OR locked_by <> computed_by", name: "payroll_runs_lock_not_computer")
    @@check(expression: "period_to >= period_from", name: "payroll_runs_period_order")
    @@map("payroll_runs")
  }

  model RunLine {
    id                Uuid              @id @default(uuid(7))
    runId             Uuid              @map("run_id")
    employeeId        Uuid              @map("employee_id")
    siteId            Uuid?             @map("site_id")
    paidDays          Numeric(5, 1)     @map("paid_days")
    lopDays           Numeric(5, 1)     @map("lop_days")
    otHours           Numeric(6, 2)     @map("ot_hours")
    grossPaise        BigInt            @map("gross_paise")
    deductionsPaise   BigInt            @map("deductions_paise")
    netPaise          BigInt            @map("net_paise")
    employerCostPaise BigInt            @map("employer_cost_paise")
    pfWagesPaise      BigInt            @map("pf_wages_paise")
    epsWagesPaise     BigInt            @map("eps_wages_paise")
    edliWagesPaise    BigInt            @map("edli_wages_paise")
    esiGrossPaise     BigInt            @map("esi_gross_paise")
    lineHash          Char(64)          @map("line_hash")
    snapshot          Jsonb // resolved settings + rule ids + Sep-2026 split parts
    status            RunLineStatus     @default(OK)
    holdReason        String?           @map("hold_reason")
    createdAt         Timestamptz(6)    @default(now()) @map("created_at")

    run               PayrollRun        @relation(fields: [runId], references: [id])
    employee          Employee          @relation(fields: [employeeId], references: [id])
    site              Site?             @relation(fields: [siteId], references: [id])
    items             RunLineItem[]
    payments          Payment[]
    cashPayout        CashPayout?
    payslips          PayslipDocument[]

    @@unique([runId, employeeId])
    @@index([employeeId])
    @@check(expression: "net_paise = gross_paise - deductions_paise", name: "run_lines_net_math")
    @@map("run_lines")
  }

  /// Every rupee on the payslip is one row.
  model RunLineItem {
    id          Uuid            @id @default(uuid(7))
    runLineId   Uuid            @map("run_line_id")
    componentId Uuid            @map("component_id")
    kind        ComponentKind
    amountPaise BigInt          @map("amount_paise")
    advanceId   Uuid?           @map("advance_id")
    note        String?

    runLine     RunLine         @relation(fields: [runLineId], references: [id], onDelete: Cascade)
    component   SalaryComponent @relation(fields: [componentId], references: [id])
    advance     Advance?        @relation(fields: [advanceId], references: [id])

    @@index([runLineId])
    @@map("run_line_items")
  }

  model Advance {
    id              Uuid            @id @default(uuid(7))
    employeeId      Uuid            @map("employee_id")
    amountPaise     BigInt          @map("amount_paise")
    instalmentPaise BigInt          @map("instalment_paise")
    balancePaise    BigInt          @map("balance_paise")
    givenOn         Date            @map("given_on")
    mode            PaymentMode
    status          AdvanceStatus   @default(ACTIVE)
    createdAt       Timestamptz(6)  @default(now()) @map("created_at")
    createdBy       Uuid?           @map("created_by")
    approvedBy      Uuid?           @map("approved_by")
    approvedAt      Timestamptz(6)? @map("approved_at")

    employee        Employee        @relation(fields: [employeeId], references: [id])
    recoveries      RunLineItem[]

    @@index([employeeId, status])
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "advances_maker_checker")
    @@check(expression: "amount_paise > 0 AND instalment_paise > 0 AND balance_paise >= 0", name: "advances_amounts")
    @@map("advances")
  }

  model FnfCase {
    id             Uuid           @id @default(uuid(7))
    employeeId     Uuid           @map("employee_id")
    exitEventId    Uuid           @map("exit_event_id")
    lastWorkingDay Date           @map("last_working_day")
    dueBy          Date           @map("due_by") // 2 working days
    status         FnfStatus      @default(OPEN)
    runId          Uuid?          @map("run_id")
    statementKey   String?        @map("statement_key")
    nomineeId      Uuid?          @map("nominee_id") // deceased worker
    createdAt      Timestamptz(6) @default(now()) @map("created_at")
    createdBy      Uuid?          @map("created_by")

    employee       Employee       @relation(fields: [employeeId], references: [id])
    exitEvent      EmployeeEvent  @relation(fields: [exitEventId], references: [id])
    run            PayrollRun?    @relation(fields: [runId], references: [id])
    nominee        Nominee?       @relation(fields: [nomineeId], references: [id])

    @@index([status, dueBy])
    @@map("fnf_cases")
  }

  model PaymentBatch {
    id                 Uuid              @id @default(uuid(7))
    runId              Uuid?             @map("run_id")
    dailyPayoutBatchId Uuid?             @map("daily_payout_batch_id")
    mode               PaymentMode
    format             PaymentFileFormat @default(GENERIC_CSV)
    fileKey            String?           @map("file_key")
    totalPaise         BigInt            @map("total_paise")
    count              Int
    status             BatchStatus       @default(DRAFT)
    paidOn             Date?             @map("paid_on")
    createdAt          Timestamptz(6)    @default(now()) @map("created_at")
    createdBy          Uuid?             @map("created_by")
    approvedBy         Uuid?             @map("approved_by")
    approvedAt         Timestamptz(6)?   @map("approved_at")

    run                PayrollRun?       @relation(fields: [runId], references: [id])
    dailyPayoutBatch   DailyPayoutBatch? @relation(fields: [dailyPayoutBatchId], references: [id])
    payments           Payment[]

    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "payment_batches_maker_checker")
    @@map("payment_batches")
  }

  model Payment {
    id                 Uuid                 @id @default(uuid(7))
    runLineId          Uuid?                @map("run_line_id")
    dailyPayoutBatchId Uuid?                @map("daily_payout_batch_id")
    batchId            Uuid?                @map("batch_id")
    mode               PaymentMode
    amountPaise        BigInt               @map("amount_paise")
    status             PaymentStatus        @default(PENDING)
    utr                VarChar(40)?
    failureReason      String?              @map("failure_reason")
    createdAt          Timestamptz(6)       @default(now()) @map("created_at")
    updatedAt          temporal.updatedAt() @map("updated_at")

    runLine            RunLine?             @relation(fields: [runLineId], references: [id])
    dailyPayoutBatch   DailyPayoutBatch?    @relation(fields: [dailyPayoutBatchId], references: [id])
    batch              PaymentBatch?        @relation(fields: [batchId], references: [id])

    @@index([runLineId])
    @@index([batchId])
    @@check(expression: "amount_paise > 0", name: "payments_amount_positive")
    @@check(expression: "num_nonnulls(run_line_id, daily_payout_batch_id) = 1", name: "payments_one_source")
    @@map("payments")
  }

  /// Closes only when paid + returned = released (enforced in the app; amounts checked by @@check).
  model CashRelease {
    id                 Uuid              @id @default(uuid(7))
    siteId             Uuid              @map("site_id")
    runId              Uuid?             @map("run_id")
    dailyPayoutBatchId Uuid?             @map("daily_payout_batch_id")
    supervisorId       Uuid              @map("supervisor_id")
    amountPaise        BigInt            @map("amount_paise")
    releasedOn         Date              @map("released_on")
    status             CashReleaseStatus @default(OPEN)
    closedAt           Timestamptz(6)?   @map("closed_at")
    createdAt          Timestamptz(6)    @default(now()) @map("created_at")
    createdBy          Uuid?             @map("created_by")
    approvedBy         Uuid?             @map("approved_by")
    approvedAt         Timestamptz(6)?   @map("approved_at")

    site               Site              @relation(fields: [siteId], references: [id])
    run                PayrollRun?       @relation(fields: [runId], references: [id])
    dailyPayoutBatch   DailyPayoutBatch? @relation(fields: [dailyPayoutBatchId], references: [id])
    supervisor         Employee          @relation("CashReleaseSupervisor", fields: [supervisorId], references: [id])
    payouts            CashPayout[]
    returns            CashReturn[]

    @@index([supervisorId, status])
    @@index([siteId])
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "cash_releases_maker_checker")
    @@check(expression: "amount_paise > 0", name: "cash_releases_amount_positive")
    @@map("cash_releases")
  }

  model CashPayout {
    id            Uuid             @id @default(uuid(7))
    cashReleaseId Uuid             @map("cash_release_id")
    runLineId     Uuid?            @unique @map("run_line_id") // a worker can't be paid twice
    dailyWorkerId Uuid?            @map("daily_worker_id")
    amountPaise   BigInt           @map("amount_paise")
    status        CashPayoutStatus @default(RELEASED)
    paidOn        Date?            @map("paid_on")
    ackPhotoKey   String?          @map("ack_photo_key")
    markedBy      Uuid?            @map("marked_by")
    verifiedBy    Uuid?            @map("verified_by")
    verifiedAt    Timestamptz(6)?  @map("verified_at")
    createdAt     Timestamptz(6)   @default(now()) @map("created_at")

    cashRelease   CashRelease      @relation(fields: [cashReleaseId], references: [id])
    runLine       RunLine?         @relation(fields: [runLineId], references: [id])
    dailyWorker   app.DailyWorker? @relation(fields: [dailyWorkerId], references: [id])

    @@unique([cashReleaseId, dailyWorkerId])
    @@index([status])
    @@check(expression: "amount_paise > 0", name: "cash_payouts_amount_positive")
    @@check(expression: "num_nonnulls(run_line_id, daily_worker_id) = 1", name: "cash_payouts_one_payee")
    @@check(expression: "status IN ('RELEASED','UNPAID') OR ack_photo_key IS NOT NULL", name: "cash_payouts_ack_before_paid")
    @@map("cash_payouts")
  }

  model CashReturn {
    id            Uuid           @id @default(uuid(7))
    cashReleaseId Uuid           @map("cash_release_id")
    amountPaise   BigInt         @map("amount_paise")
    returnedOn    Date           @map("returned_on")
    receivedBy    Uuid           @map("received_by")
    createdAt     Timestamptz(6) @default(now()) @map("created_at")

    cashRelease   CashRelease    @relation(fields: [cashReleaseId], references: [id])

    @@index([cashReleaseId])
    @@check(expression: "amount_paise > 0", name: "cash_returns_amount_positive")
    @@map("cash_returns")
  }

  model DailyPayoutBatch {
    id             Uuid             @id @default(uuid(7))
    siteId         Uuid             @map("site_id")
    periodFrom     Date             @map("period_from")
    periodTo       Date             @map("period_to")
    totalPaise     BigInt           @map("total_paise")
    status         BatchStatus      @default(DRAFT)
    createdAt      Timestamptz(6)   @default(now()) @map("created_at")
    createdBy      Uuid?            @map("created_by")
    approvedBy     Uuid?            @map("approved_by")
    approvedAt     Timestamptz(6)?  @map("approved_at")

    site           Site             @relation(fields: [siteId], references: [id])
    entries        DailyWorkEntry[]
    paymentBatches PaymentBatch[]
    payments       Payment[]
    cashReleases   CashRelease[]

    @@index([siteId, periodFrom])
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "daily_payout_batches_maker_checker")
    @@map("daily_payout_batches")
  }

  /// Supervisor travel paid per km (Module 9).
  model TravelLog {
    id         Uuid           @id @default(uuid(7))
    employeeId Uuid           @map("employee_id")
    date       Date
    km         Numeric(7, 1)
    fromSiteId Uuid?          @map("from_site_id")
    toSiteId   Uuid?          @map("to_site_id")
    status     ApprovalStatus @default(PENDING)
    createdAt  Timestamptz(6) @default(now()) @map("created_at")
    createdBy  Uuid?          @map("created_by")
    approvedBy Uuid?          @map("approved_by")

    employee   Employee       @relation(fields: [employeeId], references: [id])
    fromSite   Site?          @relation("TravelFromSite", fields: [fromSiteId], references: [id])
    toSite     Site?          @relation("TravelToSite", fields: [toSiteId], references: [id])

    @@index([employeeId, date])
    @@check(expression: "approved_by IS NULL OR created_by IS NULL OR approved_by <> created_by", name: "travel_logs_maker_checker")
    @@map("travel_logs")
  }

  /// P1 (Module 9).
  model SupervisorCostAllocation {
    id           Uuid        @id @default(uuid(7))
    runId        Uuid        @map("run_id")
    supervisorId Uuid        @map("supervisor_id")
    clientId     Uuid        @map("client_id")
    basis        VarChar(20) // BY_HEADCOUNT, EQUAL_PER_SITE
    amountPaise  BigInt      @map("amount_paise")

    run          PayrollRun  @relation(fields: [runId], references: [id])
    supervisor   Employee    @relation(fields: [supervisorId], references: [id])
    client       Client      @relation(fields: [clientId], references: [id])

    @@unique([runId, supervisorId, clientId], map: "supervisor_cost_alloc_run_sup_client_key")
    @@map("supervisor_cost_allocations")
  }

  model ComplianceFile {
    id              Uuid                 @id @default(uuid(7))
    type            ComplianceFileType
    establishmentId Uuid                 @map("establishment_id")
    wageMonth       Date                 @map("wage_month")
    runIds          Uuid[]               @map("run_ids")
    fileKey         String               @map("file_key")
    totals          Jsonb
    status          ComplianceFileStatus @default(GENERATED)
    portalRef       VarChar(60)?         @map("portal_ref")
    createdAt       Timestamptz(6)       @default(now()) @map("created_at")
    createdBy       Uuid?                @map("created_by")

    establishment   Establishment        @relation(fields: [establishmentId], references: [id])
    challans        Challan[]

    @@index([establishmentId, wageMonth, type])
    @@map("compliance_files")
  }

  model Challan {
    id               Uuid           @id @default(uuid(7))
    complianceFileId Uuid           @map("compliance_file_id")
    amountPaise      BigInt         @map("amount_paise")
    dueOn            Date           @map("due_on")
    paidOn           Date?          @map("paid_on")
    reference        VarChar(60)? // TRRN / challan no.
    receiptKey       String?        @map("receipt_key")
    createdAt        Timestamptz(6) @default(now()) @map("created_at")
    createdBy        Uuid?          @map("created_by")

    complianceFile   ComplianceFile @relation(fields: [complianceFileId], references: [id])

    @@index([complianceFileId])
    @@map("challans")
  }

  /// P1.
  model ContractorLicence {
    id         Uuid           @id @default(uuid(7))
    stateCode  VarChar(4)     @map("state_code")
    licenceNo  VarChar(60)    @map("licence_no")
    validTo    Date           @map("valid_to")
    maxWorkers Int?           @map("max_workers")
    createdAt  Timestamptz(6) @default(now()) @map("created_at")

    state      State          @relation(fields: [stateCode], references: [code])
    workOrders WorkOrder[]

    @@map("contractor_licences")
  }

  /// P1.
  model WorkOrder {
    id        Uuid               @id @default(uuid(7))
    clientId  Uuid               @map("client_id")
    licenceId Uuid?              @map("licence_id")
    number    VarChar(60)
    fromDate  Date               @map("from_date")
    toDate    Date?              @map("to_date")
    workers   Int?
    createdAt Timestamptz(6)     @default(now()) @map("created_at")

    client    Client             @relation(fields: [clientId], references: [id])
    licence   ContractorLicence? @relation(fields: [licenceId], references: [id])

    @@map("work_orders")
  }

  model ImportJob {
    id         Uuid            @id @default(uuid(7))
    type       VarChar(40) // EMPLOYEES, BANK, RATES, MIN_WAGES...
    fileKey    String          @map("file_key")
    mode       ImportMode      @default(VALID_ONLY)
    status     JobStatus       @default(QUEUED)
    counts     Jsonb?
    createdAt  Timestamptz(6)  @default(now()) @map("created_at")
    createdBy  Uuid?           @map("created_by")
    finishedAt Timestamptz(6)? @map("finished_at")

    rows       ImportRow[]

    @@index([type, createdAt])
    @@map("import_jobs")
  }

  model ImportRow {
    id       Uuid             @id @default(uuid(7))
    jobId    Uuid             @map("job_id")
    rowNo    Int              @map("row_no")
    data     Jsonb
    errors   Jsonb?
    result   ImportRowResult?
    entityId Uuid?            @map("entity_id")

    job      ImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)

    @@unique([jobId, rowNo])
    @@map("import_rows")
  }

  model ExportJob {
    id        Uuid           @id @default(uuid(7))
    layoutId  Uuid?          @map("layout_id")
    entity    VarChar(40)
    filters   Jsonb?
    fileKey   String?        @map("file_key")
    rows      Int?
    masked    Boolean        @default(true)
    status    JobStatus      @default(QUEUED)
    createdAt Timestamptz(6) @default(now()) @map("created_at")
    createdBy Uuid?          @map("created_by")

    layout    ExportLayout?  @relation(fields: [layoutId], references: [id])

    @@index([createdBy, createdAt])
    @@map("export_jobs")
  }

  /// P1 saved layouts.
  model ExportLayout {
    id        Uuid           @id @default(uuid(7))
    name      VarChar(120)
    entity    VarChar(40)
    columns   Jsonb
    clientId  Uuid?          @map("client_id")
    createdAt Timestamptz(6) @default(now()) @map("created_at")
    createdBy Uuid?          @map("created_by")

    client    Client?        @relation(fields: [clientId], references: [id])
    jobs      ExportJob[]

    @@map("export_layouts")
  }

  model PayslipDocument {
    id             Uuid             @id @default(uuid(7))
    runLineId      Uuid             @map("run_line_id")
    version        Int              @default(1)
    template       VarChar(30) // DEPLOYED, INTERNAL, CONTRACT, FNF
    fileKey        String?          @map("file_key")
    sha256         Char(64)?
    lineHash       Char(64)         @map("line_hash")
    supersededById Uuid?            @unique @map("superseded_by_id")
    status         PayslipStatus    @default(GENERATING)
    createdAt      Timestamptz(6)   @default(now()) @map("created_at")

    runLine        RunLine          @relation(fields: [runLineId], references: [id])
    supersededBy   PayslipDocument? @relation("PayslipVersions", fields: [supersededById], references: [id])
    supersedes     PayslipDocument? @relation("PayslipVersions")
    deliveries     Delivery[]
    tokens         AccessToken[]
    accessLog      AccessLog[]

    @@unique([runLineId, version])
    @@map("payslip_documents")
  }

  model DeliveryBatch {
    id         Uuid           @id @default(uuid(7))
    runId      Uuid           @map("run_id")
    kind       DeliveryKind
    counts     Jsonb?
    createdAt  Timestamptz(6) @default(now()) @map("created_at")
    createdBy  Uuid?          @map("created_by")

    run        PayrollRun     @relation(fields: [runId], references: [id])
    deliveries Delivery[]

    @@index([runId])
    @@map("delivery_batches")
  }

  model Delivery {
    id            Uuid             @id @default(uuid(7))
    batchId       Uuid             @map("batch_id")
    documentId    Uuid             @map("document_id")
    channel       Channel          @default(SMS)
    toMobile      VarChar(15)?     @map("to_mobile")
    templateId    Uuid?            @map("template_id")
    providerMsgId VarChar(80)?     @map("provider_msg_id")
    status        DeliveryStatus   @default(QUEUED)
    reason        VarChar(80)?
    attempts      SmallInt         @default(0)
    submittedAt   Timestamptz(6)?  @map("submitted_at")
    deliveredAt   Timestamptz(6)?  @map("delivered_at")
    openedAt      Timestamptz(6)?  @map("opened_at")
    createdAt     Timestamptz(6)   @default(now()) @map("created_at")

    batch         DeliveryBatch    @relation(fields: [batchId], references: [id])
    document      PayslipDocument  @relation(fields: [documentId], references: [id])
    template      MessageTemplate? @relation(fields: [templateId], references: [id])
    outbox        SmsOutbox?

    @@index([batchId, status])
    @@index([providerMsgId])
    @@map("deliveries")
  }

  /// DOB gate. Only the hash of the 10-char token is stored.
  model AccessToken {
    id          Uuid            @id @default(uuid(7))
    tokenHash   Char(64)        @unique @map("token_hash")
    documentId  Uuid            @map("document_id")
    expiresAt   Timestamptz(6)  @map("expires_at")
    revokedAt   Timestamptz(6)? @map("revoked_at")
    failedCount SmallInt        @default(0) @map("failed_count")
    lockedUntil Timestamptz(6)? @map("locked_until")
    createdAt   Timestamptz(6)  @default(now()) @map("created_at")

    document    PayslipDocument @relation(fields: [documentId], references: [id])
    log         AccessLog[]

    @@index([documentId])
    @@map("access_tokens")
  }

  model AccessLog {
    id         Uuid            @id @default(uuid(7))
    tokenId    Uuid?           @map("token_id")
    userId     Uuid?           @map("user_id")
    documentId Uuid            @map("document_id")
    ip         Inet?
    userAgent  String?         @map("user_agent")
    result     AccessResult
    at         Timestamptz(6)  @default(now())

    token      AccessToken?    @relation(fields: [tokenId], references: [id])
    document   PayslipDocument @relation(fields: [documentId], references: [id])

    @@index([documentId, at])
    @@map("access_log")
  }

  model MessageTemplate {
    id            Uuid           @id @default(uuid(7))
    channel       Channel
    kind          DeliveryKind
    language      VarChar(5)     @default("en")
    dltTemplateId VarChar(40)?   @map("dlt_template_id")
    /// The SMS provider's template id (MSG91 template_id); overrides the MSG91_TPL_* default.
    providerTemplateId VarChar(40)? @map("provider_template_id")
    body          String
    segments      SmallInt
    status        TemplateStatus @default(DRAFT)
    createdAt     Timestamptz(6) @default(now()) @map("created_at")
    createdBy     Uuid?          @map("created_by")

    deliveries    Delivery[]

    @@index([channel, kind, language, status])
    @@map("message_templates")
  }

  /// Mock SmsProvider writes here; the Outbox screen reads it.
  model SmsOutbox {
    id         Uuid           @id @default(uuid(7))
    deliveryId Uuid?          @unique @map("delivery_id")
    toMobile   VarChar(15)    @map("to_mobile")
    body       String
    createdAt  Timestamptz(6) @default(now()) @map("created_at")

    delivery   Delivery?      @relation(fields: [deliveryId], references: [id])

    @@index([createdAt])
    @@map("sms_outbox")
  }
}

namespace vault {
  /// Aadhaar store (UIDAI "Aadhaar Data Vault"). Only the vault DB role can read it.
  model AadhaarRecord {
    id            Uuid             @id @default(uuid(7))
    employeeId    Uuid?            @unique @map("employee_id")
    dailyWorkerId Uuid?            @unique @map("daily_worker_id")
    aadhaarEnc    Bytes            @map("aadhaar_enc") // AES-256-GCM: iv | ciphertext | tag
    keyVersion    Int              @map("key_version")
    lookupHmac    VarChar(64)      @unique @map("lookup_hmac")
    last4         Char(4)
    cardImageKey  String?          @map("card_image_key")
    removedAt     Timestamptz(6)?  @map("removed_at")
    createdAt     Timestamptz(6)   @default(now()) @map("created_at")
    createdBy     Uuid?            @map("created_by")

    employee      app.Employee?    @relation(fields: [employeeId], references: [id])
    dailyWorker   app.DailyWorker? @relation(fields: [dailyWorkerId], references: [id])

    @@check(expression: "num_nonnulls(employee_id, daily_worker_id) = 1", name: "aadhaar_one_subject")
    @@map("aadhaar_records")
  }
}

namespace audit {
  /// Append-only. The app DB role gets INSERT + SELECT only (see sql/001_extras.sql).
  model AuditLog {
    id       Uuid           @id @default(uuid(7))
    actorId  Uuid?          @map("actor_id")
    action   VarChar(60)
    entity   VarChar(60)
    entityId Uuid?          @map("entity_id")
    before   Jsonb?
    after    Jsonb?
    reason   String?
    ip       Inet?
    at       Timestamptz(6) @default(now())

    @@index([entity, entityId, at])
    @@index([actorId, at])
    @@index([at])
    @@map("audit_log")
  }
}
